<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- For sharing the installed APK from private cache directory -->
    <cache-path name="shared_apk" path="export/" />
    
    <!-- For installing downloaded OTA updates from private files directory -->
    <files-path name="ota_updates" path="updates/" />

    <!-- For attachments, camera photos, and exported files from private files directory -->
    <files-path name="attachments" path="attachments/" />
    <files-path name="all_files" path="." />
</paths>
